<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AchievementTemplateActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Achievement Templates"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="Define a tiered achievement set once, then generate it all in LifeUp with one tap"
            android:textSize="14sp"
            android:textColor="#666666" />

        <!-- Section 1: Saved templates -->
        <TextView
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Saved templates" />

        <TextView
            style="@style/SectionHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Templates are stored locally only, not sent anywhere." />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Template name" />

        <EditText
            android:id="@+id/templateNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Habit Tier Track"
            android:inputType="text"
            android:autofillHints="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/saveTemplateButton"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="0dp"
                android:text="Save as template" />

            <Button
                android:id="@+id/newTemplateButton"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Start blank" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/savedTemplateListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/noSavedTemplatesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="No saved templates yet."
            android:textSize="14sp"
            android:textColor="#666666" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#E0E0E0" />

        <!-- Section 2: Variables -->
        <TextView
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Variables" />

        <TextView
            style="@style/SectionHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Variables you can reuse in category names and tier names/descriptions below, written as {name}." />

        <LinearLayout
            android:id="@+id/variableListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/addVariableButton"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:paddingHorizontal="0dp"
            android:text="+ Add variable" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#E0E0E0" />

        <!-- Section 3: Common to all tiers -->
        <TextView
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. Common to all tiers" />

        <TextView
            style="@style/SectionHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hint_common_to_all_tiers" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category" />

        <RadioGroup
            android:id="@+id/categoryModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/newCategoryRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="New category" />

            <RadioButton
                android:id="@+id/existingCategoryRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Existing category" />

        </RadioGroup>

        <LinearLayout
            android:id="@+id/newCategoryGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Achievement category name" />

            <EditText
                android:id="@+id/categoryNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. {name} Tiers"
                android:inputType="text"
                android:autofillHints="" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/existingCategoryGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Existing category ID" />

            <EditText
                android:id="@+id/existingCategoryIdInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. 17"
                android:inputType="number"
                android:autofillHints="" />

            <Button
                android:id="@+id/pickCategoryButton"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="0dp"
                android:text="Pick from LifeUp categories…" />

            <TextView
                style="@style/FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Subcategory name" />

            <EditText
                android:id="@+id/subcategoryNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. {name} Tiers"
                android:inputType="text"
                android:autofillHints="" />

        </LinearLayout>

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Skill IDs for EXP reward (comma-separated, optional)" />

        <EditText
            android:id="@+id/skillIdsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 1, 4"
            android:inputType="text"
            android:autofillHints="" />

        <Switch
            android:id="@+id/sharedConditionToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Use one shared unlock condition for all tiers" />

        <LinearLayout
            android:id="@+id/sharedConditionGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unlock condition" />

            <Spinner
                android:id="@+id/sharedConditionSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/sharedRelatedIdLabel"
                style="@style/FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                tools:text="Task ID" />

            <EditText
                android:id="@+id/sharedRelatedIdInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. task id/gid"
                android:inputType="text"
                android:autofillHints="" />

            <Button
                android:id="@+id/sharedPickTaskButton"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="0dp"
                android:text="Pick from LifeUp tasks…" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#E0E0E0" />

        <!-- Section 4: Tiers -->
        <TextView
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4. Tiers" />

        <TextView
            style="@style/SectionHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="One achievement per tier. Reference your variables with {name}, {something}, etc." />

        <LinearLayout
            android:id="@+id/tierListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/addTierButton"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:paddingHorizontal="0dp"
            android:text="+ Add tier" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#E0E0E0" />

        <Button
            android:id="@+id/generateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate category + achievements in LifeUp" />

    </LinearLayout>

</ScrollView>
